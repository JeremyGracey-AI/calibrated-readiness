# Calibrated Readiness - Azure / Foundry settings for the LIVE demo only.
# Copy to .env and fill in. The offline demo and the 60-second verification
# need none of these.

# Azure AI Foundry project endpoint (Foundry portal -> project -> Overview).
FOUNDRY_PROJECT_ENDPOINT="https://<your-project>.services.ai.azure.com/api/projects/<project>"

# Model deployment name. Foundry IQ agentic retrieval requires an Azure OpenAI model.
FOUNDRY_MODEL_DEPLOYMENT="gpt-4o"

# Azure AI Search service endpoint backing the Foundry IQ knowledge base.
AZURE_SEARCH_ENDPOINT="https://<your-search>.search.windows.net"

# Name of the Foundry IQ knowledge base to ground the agents on
# (create it from the 3 docs in knowledge/ - see docs/LIVE_FOUNDRY_NOTES.md).
FOUNDRY_KNOWLEDGE_BASE="calibrated-readiness-kb"

# Retrieval reasoning effort: minimal | low | medium  (medium = full query planning)
FOUNDRY_RETRIEVAL_EFFORT="medium"

# Auth: code uses DefaultAzureCredential (managed identity first, then az CLI /
# VS Code / env). For local dev, `az login` is usually enough. No keys in code.
